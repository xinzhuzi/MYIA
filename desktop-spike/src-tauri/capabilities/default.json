{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "spike 最小权限:核心事件 + sidecar 执行(args 全放开,仅 spike)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/myia",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
