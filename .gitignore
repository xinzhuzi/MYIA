# ===== 安全红线:私有数据零上传 =====
# 本仓库与 .trellis/ 都会公开;任何凭据、抓取数据、密钥文件不得入库。
# MYIA 凭据只走 env:/keychain: 引用,配置文件出现明文凭据即拒跑(spec 铁律)。

# ---- 密钥与凭据文件(防误拷入仓库)----
*.pem
*.key
*.p12
*.pfx
secrets.*
# 例外:核心源码模块不叫"secrets 文件",必须入库(fresh clone / wheel 缺它即崩)
!src/myia/secrets.py
.env
.env.*
.envrc

# ---- 本地私有路径索引(真实姓名/内网拓扑,仅本机)----
LOCAL-NOTES.md

# ---- MYIA 运行时数据(抓取的情报内容属私有数据)----
myia.db
*.db-journal
*.db-wal
*.db-shm
data/
# 例外:随包分发的程序数据(prompt/关键词表)不是抓取数据,必须入库与进 wheel
!src/myia/classify/data/
!src/myia/enrich/data/
!myia-classifier/myia_classifier/data/
# credhunter 指纹库数据(20 发现查询包 + 25 验证规格)同上:程序数据非抓取
# 产物,fresh clone/CI 缺它即三 lane 启动全坏(10-03-aipocket-fusion R3)。
!plugins/myia-credhunter/credhunter/data/
out/
output/
exports/
backups/
/logs/
*.log
# 场景插件运行时产物(osint 类插件的侦察情报:邮箱/密钥泄漏指纹等)
# 与抓取数据同级零容忍:插件安装根可在仓库树内(repo 内 compose 副本原地跑、
# MYIA_PLUGIN_DIR 指向仓库),loot/ 落进工作树就必须被防线覆盖。
plugins/**/loot/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ---- 工作流运行态(本机私有,勿提交;.zcode/workflows/ 保存的工作流除外)----
.zcode/workflow-drafts/
.zcode/workflow-runs/

# ---- Node / 桌面端(desktop/ 是打包正式出处;构建产物可达 ~1GB,严禁入库)----
node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/.venv-build/
desktop/build-pyi/
desktop/.pyinstaller-cache/
desktop/ui/
desktop/src-tauri/binaries/

# ---- GitNexus 本地索引(知识图谱 DB,本机私有;WAL 损坏勿提交)----
.gitnexus/
# gitnexus analyze 的自动副作用副本:MYIA 用全局技能(~/.agents/skills)+ AGENTS.md,不提交
# (将来要手写 CLAUDE.md 时,先移除下一行规则)
.claude/
CLAUDE.md

# ---- 编辑器 / OS ----
.idea/
.vscode/
.DS_Store
*.bak
*~
Thumbs.db

# ---- 冒烟运行态(本机私有,勿提交)----
.zcode/smoke/

# ---- 仓库根误落的运行时产物(防误提交)----
# 消息屏目录/别名是运行态数据,正常应落数据根(MYIA_HOME);desktop serve 在
# 仓库 cwd 下直跑时缺省写到仓库根——内容含真实平台 chat_id 与群名(私有
# 标识,同 myia.db 零容忍口径),且会随每次 discover 变化,严禁入库。
/channel_aliases.json
/channel_directory.json
/channel_dead.json
# credhunter 全文密钥库(指纹→原文,含真实密钥——比 channel_* 更敏感,
# 零容忍口径同 myia.db):正常应落数据根(MYIA_HOME),引擎缺省路径在仓库
# cwd 直跑时会落仓库根,严禁入库(10-03-aipocket-fusion Q9)。
/credhunter-keystore.json
# 技能工具链的本地锁文件(本机技能版本快照,非仓库配置)
/skills-lock.json
