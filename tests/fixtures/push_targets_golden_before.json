     "Accept": "application/json"
    },
    "method": "GET",
    "name": "yahoo-chart",
    "pagination": null,
    "post_body": null,
    "proxy": "direct",
    "rate_limit": {
     "backoff": "exponential",
     "jitter": 2.0,
     "qps": 0.5,
     "respect_robots": false
    },
    "retry": 3,
    "symbols": [
     "NVDA",
     "AAPL",
     "TSLA",
     "0700.HK",
     "600519.SS"
    ],
    "url": "https://query1.finance.yahoo.com/v8/finance/chart/{symbol}?range=5d&interval=1d"
   }
  ],
  "storage": {
   "retention": "90d",
   "vacuum": "monthly"
  },
  "timezone": "Asia/Shanghai",
