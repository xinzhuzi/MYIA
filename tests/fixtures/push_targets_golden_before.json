 "plugins/stocks.yaml": {
  "classify": {
   "builtin": false,
   "rules": [
    {
     "name": "异动",
     "tag": "大涨/大跌",
     "when": "abs(change_pct) >= 3"
    }
   ]
  },
  "dedup": {
   "key": "{symbol}-{date}-{slot}"
  },
  "enrich": {
   "api_key": null,
   "base_url": null,
   "batch": 20,
   "budget_per_run": 50000,
   "cache": true,
   "enabled": false,
   "model": "glm-4-flash",
   "scores": [
    "value",
    "relevance",
    "credibility"
   ]
  },
  "id": "stocks",
  "name": "股票情报",
  "push": [
   {
    "channel": "feishu_card",
    "retries": 2,
    "retry_backoff_seconds": 1.0,
    "route": [
     {
      "mode": "immediate",
      "when": "score >= 8"
     },
     {
      "mode": "immediate",
      "when": "abs(change_pct) >= 3"
     },
     {
      "mode": "digest",
      "when": "abs(change_pct) < 3"
     }
    ],
    "target": "env:FEISHU_CHAT_ID",
    "template": "**股票情报 · {{ date }}**\n{% for item in items %}\n- {{ item.symbol }} {{ item.change_pct }}% 现价 {{ item.price }} {{ item.currency }}\n{% endfor %}\n",
    "timeout": 10.0
   }
  ],
  "schedule": "0 9,15 * * 1-5",
  "sources": [
   {
    "engine": "direct_api",
    "extract": {
     "fields": {
      "change_pct": "$.chart.result[0].meta.regularMarketChangePercent",
      "currency": "$.chart.result[0].meta.currency",
      "price": "$.chart.result[0].meta.regularMarketPrice",
      "symbol": "$.chart.result[0].meta.symbol",
      "title": "$.chart.result[0].meta.longName",
      "url": "$.chart.result[0].meta.symbol"
     },
     "item": null,
     "type": "json_path"
    },
    "headers": {
     "Accept": "application/json"
    },
    "method": "GET",
    "name": "yahoo-chart",
    "pagination": null,
    "post_body": null,
    "proxy": "direct",
    "rate_limit": {
     "backoff": "exponential",
     "jitter": 2.0,
     "qps": 0.5,
     "respect_robots": false
    },
    "retry": 3,
    "symbols": [
     "NVDA",
     "AAPL",
     "TSLA",
     "0700.HK",
     "600519.SS"
    ],
    "url": "https://query1.finance.yahoo.com/v8/finance/chart/{symbol}?range=5d&interval=1d"
   }
  ],
  "storage": {
   "retention": "90d",
   "vacuum": "monthly"
  },
  "timezone": "Asia/Shanghai",
  "watchlist": {
   "keywords": [
    "NVDA",
    "英伟达",
    "特斯拉",
    "苹果",
    "腾讯",
    "AI芯片"
   ],
   "mute": [
    "广告",
    "中奖"
   ]
  }
 },
