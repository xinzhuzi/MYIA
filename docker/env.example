# 世事 容器凭据模板 — 复制为 docker/.env 后填写;docker/.env 已被 .gitignore
# 覆盖(.env 规则),严禁提交进仓库。本文件本身只有空占位,不含任何凭据值。
#
# 工作机制:插件 YAML 中凭据一律写 `env:VAR` 引用;容器启动时这里声明的
# 变量进入进程环境,schema 在运行期解析(缺失的结构化报错,退出码 1)。
# 按你实际启用的插件与推送通道增删条目即可。

# ---- 飞书推送(官方插件默认通道)----
FEISHU_BOT_TOKEN=
FEISHU_CHAT_ID=

# ---- Telegram 推送(v0.2 通道;未启用可留空/删除)----
# 键名与代码解析的 env: 引用一致(src/shishi/push/telegram.py):
# token=env:TELEGRAM_BOT_TOKEN,target=env:TELEGRAM_CHAT_ID。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Firecrawl 后端(可选;L3 重渲染,不配则降级链跳过)----
MYIA_FIRECRAWL_URL=
MYIA_FIRECRAWL_API_KEY=

# ---- LLM 精评(可选,v0.2 enrich;OpenAI 兼容端点,世事 无内置端点)----
# 键名与文档一致(docs/zh/getting-started.md §2、skill/SKILL.md §2.12):
# YAML 里 enrich 的 base_url/api_key 写 env:MYIA_LLM_BASE_URL / env:MYIA_LLM_KEY。
MYIA_LLM_BASE_URL=
MYIA_LLM_KEY=

# ---- 源站凭据(仅当你的插件 YAML 里出现对应 env: 引用时才需要)----
# 示例:YAHOO_COOKIE= / LINUXDO_COOKIE= / AIPOCKET_TOKEN=
